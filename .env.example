# Copy to .env.local for local development, or set these in your hosting
# provider's environment configuration for production.

# --- Admin area (Basic Auth) -------------------------------------------------
# Protects /admin and GET /api/contacts in production (enforced by src/proxy.ts).
# Required in production: if either value is missing, the admin area responds
# with 503 instead of falling back to defaults.
# In development the admin area is open on localhost and these are ignored.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Storage (optional) ------------------------------------------------------
# Directory for the SQLite database file (krijo.db). Defaults to ./data.
# In production, point this at a persistent volume so submissions survive
# redeploys.
# DATA_DIR=/var/data/krijo
