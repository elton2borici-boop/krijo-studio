# Copy to .env.local for local development, or set these in your hosting
# provider's environment configuration for production.

# --- Admin area (Basic Auth) -------------------------------------------------
# Protects /admin and GET /api/contacts in production (enforced by src/proxy.ts).
# Required in production: if either value is missing, the admin area responds
# with 503 instead of falling back to defaults.
# In development the admin area is open on localhost and these are ignored.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Storage (optional) ------------------------------------------------------
# Directory for the SQLite database file (krijo.db). Defaults to ./data.
# In production, point this at a persistent volume so submissions survive
# redeploys.
# DATA_DIR=/var/data/krijo

# --- Lead notifications (optional) -------------------------------------------
# Without these, new leads are only visible in /admin. Set either channel, both,
# or neither — src/lib/notify.ts skips whatever is unconfigured, and a failed
# notification never fails the submission.

# Email via Resend. Both values are required for email to be sent.
# LEAD_EMAIL_FROM must be an address on a domain you have verified with Resend.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# LEAD_EMAIL_FROM="Krijo Studio <pershendetje@krijo.studio>"

# Telegram. Create a bot with @BotFather for the token, then message the bot and
# read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
